// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------
// Phase 1 schema, implementing docs/26-database-schema-design.md as the
// source of truth, cross-referenced with docs/07, /17, /18, /20, /05.
//
// A few fields/entities are not explicitly enumerated in docs/26 (which
// has no dedicated "Job Model" or "Application Model" section, and never
// mentions City or SavedJob at all). Where a concept was required by this
// implementation task but only implied — not spelled out — by the docs,
// the smallest conservative choice was made and is called out inline
// below and in the implementation report, rather than silently invented.
// -----------------------------------------------------------------------

enum UserRole {
  candidate
  employer
  admin
}

// Not named in docs/26; added because docs/06/11 describe an admin
// "suspend a user" action, which needs a stateful field to actually act
// on (ModerationAction alone only logs that an action happened).
enum UserStatus {
  active
  suspended
}

model User {
  id    String @id @default(uuid())
  email String @unique

  // Better Auth's required base User fields (added per the Prisma 7
  // compatibility spike against @better-auth/core@1.7.5's schema source).
  // These are identity fields Better Auth owns and manages directly.
  name          String
  emailVerified Boolean @default(false)
  image         String?

  // role/status remain exclusively ours: Better Auth only establishes
  // identity/session (docs/19's role-binding principle) — authorization
  // stays in src/services, never in a Better Auth plugin.
  role      UserRole
  status    UserStatus @default(active)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  candidateProfile  CandidateProfile?
  employerProfile   EmployerProfile?
  postedJobs        Job[]              @relation("JobsPostedByUser")
  moderationActions ModerationAction[] @relation("ModerationActionsByAdmin")
  moderatedAsTarget ModerationAction[] @relation("ModerationActionsOnUser")
  sessions          Session[]
  accounts          Account[]

  // Password hashes are NOT stored here — Better Auth's email/password
  // ("credential") provider stores them on Account.password, keyed by
  // (providerId, accountId), not on User.
}

// Better Auth session table — one row per active login session. Session
// lookup is by `token` (the value carried in the secure HTTP-only cookie),
// so it must be unique. Field shapes verified against
// @better-auth/core@1.7.5's session schema during the compatibility spike.
model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

// Better Auth account/credential table. For Phase 1 (email/password only)
// this holds exactly one row per user: providerId = "credential",
// accountId identifies the user within that provider, password is the
// hashed credential. The OAuth-only fields stay unused and nullable until
// (if ever) a social provider is enabled. Field shapes verified against
// @better-auth/core@1.7.5's account schema during the compatibility spike.
model Account {
  id                    String    @id @default(uuid())
  userId                String
  providerId            String
  accountId             String
  password              String?
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([providerId, accountId])
  @@index([userId])
}

// Better Auth verification-token table (email verification, password
// reset). Field shapes verified against @better-auth/core@1.7.5's
// verification schema during the compatibility spike.
model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Country {
  id                  String   @id @default(uuid())
  isoCode             String   @unique
  urlSlug             String   @unique
  name                String
  defaultCurrencyCode String
  defaultLocale       String
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  cities            City[]
  companies         Company[]
  candidateProfiles CandidateProfile[]
  jobs              Job[]
}

// Not defined as its own entity in docs/26 (§13 only mentions a
// `city`/`locationText` scalar on CandidateProfile). This task's required
// concept list treats "City" as a first-class concept alongside Country,
// and docs/17 requires a non-empty "location" on every Job submission —
// so City is modeled as a normalized lookup (mirroring Category), scoped
// to a Country, rather than free text. Flagged for docs/26 to formally
// adopt or revise.
model City {
  id        String   @id @default(uuid())
  countryId String
  name      String
  slug      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  country           Country            @relation(fields: [countryId], references: [id])
  candidateProfiles CandidateProfile[]
  jobs              Job[]

  @@unique([countryId, slug])
}

model Category {
  id               String   @id @default(uuid())
  name             String
  slug             String   @unique
  parentCategoryId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  parent   Category?  @relation("CategoryHierarchy", fields: [parentCategoryId], references: [id])
  children Category[] @relation("CategoryHierarchy")
  jobs     Job[]
}

model Skill {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  jobSkills       JobSkill[]
  candidateSkills CandidateSkill[]
}

model Company {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  websiteUrl  String?
  logoUrl     String?
  countryId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  country          Country?          @relation(fields: [countryId], references: [id])
  employerProfiles EmployerProfile[]
  jobs             Job[]
}

model CandidateProfile {
  id            String   @id @default(uuid())
  userId        String   @unique
  countryId     String
  cityId        String?
  fullName      String
  headline      String?
  resumeFileUrl String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user            User             @relation(fields: [userId], references: [id])
  country         Country          @relation(fields: [countryId], references: [id])
  city            City?            @relation(fields: [cityId], references: [id])
  candidateSkills CandidateSkill[]
  applications    Application[]
  savedJobs       SavedJob[]
}

model EmployerProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  companyId String
  jobTitle  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id])
  company Company @relation(fields: [companyId], references: [id])
}

enum JobStatus {
  pending_review
  active
  expired
  closed
  rejected
}

// `imported` added by the imported-job publishing task — the
// "future non-employer sourcing channel" this enum's own original
// comment anticipated. Purely additive: existing employer-posted rows
// keep `employer_direct`, and no existing code path's meaning changes.
enum JobSource {
  employer_direct
  imported
}

enum ApplicationMethod {
  on_platform
  external_url
}

model Job {
  id             String  @id @default(uuid())
  companyId      String
  countryId      String
  cityId         String
  categoryId     String
  postedByUserId String
  duplicateOfJobId String?

  // title/description: required per docs/17's minimum-content-at-submission
  // list; not spelled out as columns anywhere in docs/26 itself, but a Job
  // cannot function without them.
  title       String
  description String

  slug   String
  status JobStatus @default(pending_review)
  source JobSource @default(employer_direct)

  applicationMethod      ApplicationMethod
  externalApplicationUrl String?

  // currencyCode is explicitly named in docs/26 §8; salaryMin/salaryMax are
  // this task's minimal, necessary completion of it (a currency code with
  // no amount is meaningless) — not an independently-approved field, so
  // both are optional, matching that title/description/location/company
  // are the only fields docs/17 requires at submission.
  currencyCode String?
  salaryMin    Int?
  salaryMax    Int?

  postedAt        DateTime?
  expiresAt       DateTime?
  closedAt        DateTime?
  rejectionReason String?

  // Imported-job provenance (publishing task). NULL for every
  // employer-direct job — the unique constraint below allows unlimited
  // NULL pairs (Postgres treats NULL as distinct in a unique index), so
  // this adds zero constraint on existing/future employer-posted rows.
  // Deliberately plain strings, not a foreign key to AuthorizedJobSource:
  // this is provenance, not a hard relational dependency (a source
  // config could be removed later without needing to touch already-
  // published jobs). importedSourceUpdatedAt preserves the source's own
  // last-updated timestamp (e.g. Greenhouse's `updated_at`), distinct
  // from this row's own createdAt/updatedAt.
  importedSourceId       String?
  importedExternalJobId  String?
  importedSourceUpdatedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company           Company            @relation(fields: [companyId], references: [id])
  country           Country            @relation(fields: [countryId], references: [id])
  city              City               @relation(fields: [cityId], references: [id])
  category          Category           @relation(fields: [categoryId], references: [id])
  postedBy          User               @relation("JobsPostedByUser", fields: [postedByUserId], references: [id])
  duplicateOf       Job?               @relation("JobDuplicates", fields: [duplicateOfJobId], references: [id])
  duplicates        Job[]              @relation("JobDuplicates")
  jobSkills         JobSkill[]
  applications      Application[]
  savedBy           SavedJob[]
  moderationActions ModerationAction[]
  importedJobReview ImportedJobReview?

  @@unique([countryId, slug])
  @@unique([importedSourceId, importedExternalJobId])
  @@index([countryId, status])
  @@index([status, expiresAt])
  @@index([companyId])
  @@index([categoryId])
}

model JobSkill {
  id        String   @id @default(uuid())
  jobId     String
  skillId   String
  createdAt DateTime @default(now())

  job   Job   @relation(fields: [jobId], references: [id])
  skill Skill @relation(fields: [skillId], references: [id])

  @@unique([jobId, skillId])
  @@index([skillId])
}

model CandidateSkill {
  id                 String   @id @default(uuid())
  candidateProfileId String
  skillId            String
  createdAt          DateTime @default(now())

  candidateProfile CandidateProfile @relation(fields: [candidateProfileId], references: [id])
  skill            Skill            @relation(fields: [skillId], references: [id])

  @@unique([candidateProfileId, skillId])
  @@index([skillId])
}

// Single value today; docs/20 explicitly defers multi-stage statuses
// "beyond received," implying "received" is the current baseline.
enum ApplicationStatus {
  received
}

model Application {
  id                 String            @id @default(uuid())
  jobId              String
  candidateProfileId String
  // Optional note/cover message — explicitly described in docs/20.
  coverNote          String?
  status             ApplicationStatus @default(received)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  deletedAt          DateTime?

  job              Job              @relation(fields: [jobId], references: [id])
  candidateProfile CandidateProfile @relation(fields: [candidateProfileId], references: [id])

  @@unique([jobId, candidateProfileId])
  @@index([jobId])
  @@index([candidateProfileId])
}

// Not defined in docs/26 at all — this task's required concept list adds
// it. Modeled as the smallest possible candidate<->job bookmark, mirroring
// Application's shape minus lifecycle/method fields, since "saving" a job
// has no status or application method of its own.
model SavedJob {
  id                 String   @id @default(uuid())
  candidateProfileId String
  jobId              String
  createdAt          DateTime @default(now())

  candidateProfile CandidateProfile @relation(fields: [candidateProfileId], references: [id])
  job              Job              @relation(fields: [jobId], references: [id])

  @@unique([candidateProfileId, jobId])
}

model ModerationAction {
  id           String   @id @default(uuid())
  adminUserId  String
  targetJobId  String?
  targetUserId String?
  // Free-text rather than an enum: docs/06/17 give examples (approve,
  // reject, hide a listing, suspend a user) but never enumerate a
  // complete, authoritative action vocabulary.
  action       String
  reason       String?
  createdAt    DateTime @default(now())

  // Deliberately no deletedAt here despite docs/07's general "job
  // postings, applications, admin actions" soft-delete note: soft-deleting
  // an audit log entry would defeat the auditability principle in
  // docs/11-security-principles.md.
  admin      User  @relation("ModerationActionsByAdmin", fields: [adminUserId], references: [id])
  targetJob  Job?  @relation(fields: [targetJobId], references: [id])
  targetUser User? @relation("ModerationActionsOnUser", fields: [targetUserId], references: [id])

  @@index([targetJobId])
  @@index([targetUserId])
}

// Foundation for the future AI Job Acquisition Engine. This is
// CONFIGURATION only — no provider-specific fetching/connector logic
// lives here, and enabling a row never triggers an import by itself (no
// code path reads `enabled` yet). A future connector layer will read
// this registry; it must never write provider logic into it.
//
// Named AuthorizedJobSource (not JobSource) to avoid colliding with the
// existing JobSource enum on the Job model above, which tracks how an
// individual Job row was sourced (currently only `employer_direct`) —
// a distinct concept from this registry of available source configs.
enum JobSourceType {
  API
  FEED
  ATS
  OFFICIAL_CAREER_SOURCE
}

// Whether the source owner has explicitly authorized Jobnura to use/
// redistribute their job data — deliberately separate from, and never
// inferred from, technical facts like "the endpoint is public" or "the
// API responds without credentials". Only two states: an authorization
// either has been explicitly recorded, or it hasn't. No third
// "pending"/"in review" state was added — this task's own instruction
// was the smallest explicit representation, and nothing today reads or
// needs a richer workflow state.
enum JobSourceAuthorizationStatus {
  unverified
  verified
}

model AuthorizedJobSource {
  id         String        @id @default(uuid())
  name       String        @unique
  sourceType JobSourceType

  // Public configuration reference only (e.g. a documented API base URL).
  // Never a secret — see credentialEnvVarName below for how credentials
  // are referenced instead of stored.
  baseEndpoint String?

  enabled             Boolean @default(false)
  attributionRequired Boolean @default(true)

  // Defaults to "unverified" for every source, including ones that are
  // already `enabled` at migration time (none exist today, but this
  // guarantees no future row silently starts authorized). Becoming
  // `enabled: true` requires `authorizationStatus === "verified"` —
  // enforced server-side in setJobSourceEnabled, not just hidden in the
  // UI. authorizationReference is a short, non-sensitive note (e.g.
  // "Employer provided approved RaaS feed") — never credentials, never
  // legal documents, never email contents.
  authorizationStatus     JobSourceAuthorizationStatus @default(unverified)
  authorizationVerifiedAt DateTime?
  authorizationReference  String?

  // Null means "no polling configured" — most sources start this way
  // since no connector exists yet to poll on a schedule.
  refreshIntervalMinutes Int?

  // Free-text, matching ModerationAction.action's existing convention:
  // no fixed vocabulary exists yet for source health/lifecycle states.
  status String @default("not_configured")

  // Stores only the NAME of an environment variable a future connector
  // should read (e.g. "ADZUNA_APP_KEY") — never the credential value
  // itself. Null means no credential is configured for this source.
  credentialEnvVarName String?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// The admin review queue/audit trail for the imported-job publishing
// pipeline — deliberately a SEPARATE model from Job, per this task's own
// instruction to keep pending/rejected imported records out of the
// public Job table entirely. Every processed imported job gets exactly
// one row here (one per (importedSourceId, importedExternalJobId)),
// regardless of its outcome:
//   - auto_publish  -> status "published", publishedJobId set immediately
//   - admin_review  -> status "pending" until an admin approves/rejects
//   - do_not_publish -> status "rejected" immediately (auditable, never silently discarded)
// `decision` preserves the confidence-decision stage's original verdict
// forever, even after a human later changes `status` — so "what did the
// engine originally recommend" is never lost. Human admin actions
// (approve/reject) are logged via the EXISTING ModerationAction table,
// not duplicated here, since that is already this codebase's one
// audit-log convention for "an admin did X."
enum ImportedJobReviewStatus {
  pending
  published
  rejected
}

model ImportedJobReview {
  id String @id @default(uuid())

  importedSourceId      String
  importedExternalJobId String

  // A read-only snapshot of the fields an admin needs to review this
  // job, captured at import time — never re-fetched from the source,
  // never mutated after creation (updating a pending item's own content
  // is out of scope for this task; only `status`/`publishedJobId`
  // change over this row's lifetime).
  title           String
  description     String
  companyIdentity String?
  location        String?
  sourceUrl       String?
  category        String?
  country         String?
  city            String?

  // The confidence-decision stage's original verdict + machine-readable
  // reason codes — see decideImportedJobConfidence.ts. `decision` is
  // free text matching ModerationAction.action's existing convention.
  decision String
  reasons  String[]

  status          ImportedJobReviewStatus @default(pending)
  publishedJobId  String?                 @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  publishedJob Job? @relation(fields: [publishedJobId], references: [id])

  @@index([importedSourceId, importedExternalJobId])
  @@index([status])
}
